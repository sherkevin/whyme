# ─── Mydow PRD10 V1 production image ──────────────────────────────────────
#
# 目的：把 FastAPI app + 静态前端（static/mydow/）打成一个可部署镜像。
# 与旧的 ``Dockerfile`` 区别：
#   - 旧的 ``Dockerfile`` 是 Ubuntu 沙箱镜像（运行用户代码用），不是应用镜像。
#   - 这个镜像专门跑 ``agent_os.server.app:app``。
#
# 任务来源：todo-tasks.md 11.1（Owner: Agent 3 @ 2026-05-05）。
#
# 部署：
#   docker compose -f docker-compose.prd10.yml up -d
# 或单独跑：
#   docker build -f Dockerfile.prd10 -t mydow-app:latest .
#   docker run --env-file .env -p 8000:8000 mydow-app:latest
# ──────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build deps for asyncpg / cryptography / pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libpq-dev \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache pip layer: copy only metadata first
COPY pyproject.toml ./
COPY README.md ./

# Install full prod deps (PRD10 V1 stack).
RUN pip install --upgrade pip setuptools wheel && \
    pip install \
        "fastapi>=0.111" \
        "uvicorn[standard]>=0.30" \
        "sqlalchemy>=2.0,<3" \
        "asyncpg>=0.29" \
        "aiosqlite>=0.20" \
        "alembic>=1.13" \
        "pydantic>=2.0,<3" \
        "pydantic[email]>=2.0,<3" \
        "python-jose[cryptography]>=3.3" \
        "PyJWT>=2.8" \
        "passlib[bcrypt]>=1.7" \
        "argon2-cffi>=23.1" \
        "python-multipart>=0.0.9" \
        "httpx>=0.27" \
        "redis>=5.0" \
        "litellm>=1.42" \
        "PyYAML>=6.0" \
        "python-dotenv>=1.0" \
        "sentry-sdk>=2.0" \
        "typer>=0.9" \
        "rich>=13" \
        "langgraph>=0.2" \
        "aider-chat>=0.60.0"

# ─── Runtime stage ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    PORT=8000

# Runtime libs
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 mydow

WORKDIR /app

# Pull installed deps from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy app source
COPY --chown=mydow:mydow src/ src/
COPY --chown=mydow:mydow static/ static/
COPY --chown=mydow:mydow scripts/ scripts/
COPY --chown=mydow:mydow config.yaml ./
COPY --chown=mydow:mydow alembic/ alembic/

# Persistent data dir (uploads + sqlite fallback) — overridden by volume mount
RUN mkdir -p /app/data /app/data/uploads /app/logs && \
    chown -R mydow:mydow /app/data /app/logs

USER mydow

EXPOSE 8000

# Healthcheck for docker-compose / k8s
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/health || exit 1

# Default cmd: production uvicorn (no reload, single process — let nginx /
# horizontal scale). For dev: docker run ... --reload by overriding CMD.
CMD ["sh", "-c", "python -m uvicorn agent_os.server.app:app --host 0.0.0.0 --port ${PORT} --workers 1"]
