# AgentOS Configuration
# Copy this file to .env and fill in your values

# LLM API Configuration
API_KEY=your-api-key-here
BASE_URL=https://api.example.com/v1/chat/
MODEL=openai/gpt-4o-mini

# Optional: Override default model parameters
TEMPERATURE=0.7
MAX_TOKENS=4096

# Sandbox Configuration
# IMPORTANT: For multi-user production use, ensure Docker mode is enabled
# Use "docker" for production multi-user isolation (recommended)
# Use "local" for development only (not secure for multi-user)
# AGENTOS_SANDBOX=docker  # Uncomment to force Docker mode
# AGENTOS_SANDBOX=local   # Uncomment for development mode only

# Server Configuration
HOST=0.0.0.0
PORT=8003

# Resource Limits (Docker only)
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=50000  # 50% of one CPU core

# Logging
LOG_LEVEL=INFO
