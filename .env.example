# ============================================================================
# Mydow / WhyMe — Production Environment Variables (PRD10 V1)
# ============================================================================
# 复制此文件为 .env 并按部署目标修改值。
#   PowerShell:  cp .env.example .env
#
# 任务来源：todo-tasks.md 8.14（Owner: Agent 3 @ 2026-05-05）
# 真理来源：源码内 os.getenv / os.environ.get 调用 + agent_os/core/config.py
#
# 分组：
#   §1 应用基础         （端口、环境名、日志、CORS）
#   §2 数据库           （Postgres 生产 / SQLite 开发）
#   §3 安全 / Auth      （Secret、JWT、邮件验证码）
#   §4 LLM Provider     （DeepSeek/OpenAI/Anthropic 三选一）
#   §5 PRD10 行为开关   （demo / worker / AI 实启用）
#   §6 Redis            （限流、缓存、SSE pubsub）
#   §7 文件存储         （上传根目录、对象存储凭证）
#   §8 第三方集成       （微信、Sentry）
#   §9 开发与调试
#
# 凡是带 ★ 的字段是「上线必填」，未填则启动会拒绝或退化到不安全默认。
# ============================================================================


# ─── §1 应用基础 ─────────────────────────────────────────────────────────────

# `production` / `staging` / `development` — 影响 CORS、日志级别、debug 行为
ENVIRONMENT=production

LOG_LEVEL=info               # debug / info / warning / error
DEBUG=false

# FastAPI 监听端口（uvicorn 启动参数会读这里）
API_PORT=8000
WS_PORT=8003

# 部署后服务对外可访问的 base URL（前端调用的根、邮件链接、文件 commit 都用它）
BASE_URL=https://demo.example.com

# 允许跨域来源（多个用逗号分隔）。生产模式严格按这个白名单，开发模式由 CORS_ALLOW_ALL 接管
CORS_ORIGINS=https://demo.example.com,https://admin.example.com
CORS_ALLOW_ALL=false         # true 仅限本地调试，绝对不要生产开 true


# ─── §2 数据库 ───────────────────────────────────────────────────────────────

# ★ PostgreSQL（推荐）
# 格式：postgresql+asyncpg://USER:PASS@HOST:PORT/DB
DATABASE_URL=postgresql+asyncpg://agentos:agentos@postgres:5432/agentos_db

# 单独的 Postgres 凭证（docker-compose 会用）
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos_db
POSTGRES_PORT=5432

# 是否打印 SQLAlchemy 原始 SQL（性能/调试用）
AGENTOS_DB_ECHO=false
DB_ECHO=false

# 测试覆盖：本地跑测试时可指向不同 DB
# TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db


# ─── §3 安全 / Auth ──────────────────────────────────────────────────────────

# ★ JWT 签名密钥（务必生产环境改）
SECRET_KEY=please-rotate-this-secret-before-going-live
JWT_SECRET_KEY=please-rotate-this-jwt-secret-before-going-live
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 字段加密（敏感字段如手机号、第三方 token 用 Fernet 加密）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# 邮箱验证码用的 SMTP（PRD10 §3.1 / §11.7 邮箱登录依赖）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true


# ─── §4 LLM Provider ─────────────────────────────────────────────────────────
# AGENTOS_AI_LLM=on 时才走真 LLM；否则 ai/router.py 用 placeholder 回复（开发友好）。
# 三种 provider 任选其一，agent_os/llm/litellm_impl.py 按下面优先级回退：
#   API_KEY → LITELLM_API_KEY → DEEPSEEK_API_KEY → OPENAI_API_KEY
#   LLM_BASE_URL / API_BASE / DEEPSEEK_OPENAI_BASE_URL
#   LLM_MODEL / MODEL / DEEPSEEK_MODEL

# DeepSeek（推荐：默认 LLM，性价比最高）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_MODEL_FALLBACK=deepseek-v4-pro

# 或 OpenAI
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# 或 Anthropic
ANTHROPIC_API_KEY=

# 通用别名（任何一个 provider 都可以走这两个）
# API_KEY=
# LLM_BASE_URL=
# AGENTOS_LLM_ALLOW_BASE_URL=off  # legacy only: lets BASE_URL mean LLM endpoint
# MODEL=deepseek-v4-flash
# LLM_MODEL=deepseek-v4-flash
#
# §16.1 — 灵感捕获「结构化 JSON 整理」专用模型（可选）。
# 默认统一使用 DeepSeek v4 flash；如业务侧提供其他兼容模型，可显式覆盖。
# 做 title/summary/tags/folder_hint 抽取；也可用 CAPTURE_ENRICH_MODEL 显式指定。
# MODEL_FALLBACK=deepseek-v4-pro
# CAPTURE_ENRICH_MODEL=


# ─── §5 PRD10 行为开关（核心）────────────────────────────────────────────────
# 这一节决定运行时形态，与 PRD10 §24 P0 / §27 演示直接挂钩。

# Demo 模式：开启 `/api/v1/demo/login` 一键登录（投资人演示必开）
# 关：production；开：staging / 演示环境
AGENTOS_DEMO_MODE=on

# 真 LLM 调用开关。off / placeholder / 默认 = 用占位回复；on/1/true/enabled = 真调
AGENTOS_AI_LLM=on

# AI 模型温度 / 最大 token（仅当 AGENTOS_AI_LLM=on 时生效）
AGENTOS_AI_TEMPERATURE=0.3
AGENTOS_AI_MAX_TOKENS=2000

# Job 消费 worker：把 prd10_jobs 里的 ai_chat / parse_file / generate_report / skill_run
# 异步消化掉。off=不启用；on=随 FastAPI startup 起一个后台循环。
AGENTOS_PRD10_WORKER=on
AGENTOS_PRD10_WORKER_INTERVAL=2   # 秒；轮询间隔

# 沙箱后端：local / docker；local 在本机直跑命令（开发），docker 用 sandbox image（推荐）
AGENTOS_SANDBOX=docker

# 是否让旧的 LLM-based InboxItem 处理流水线启用（与 capture 流水线协同）
USE_LLM_PROCESSING=false

# ────────────────────────────────────────────────────────────────────────────
# PRD10 §29 限流（Rate limiting）
#
# 关闭时（默认）：RateLimitMiddleware 短路放行，几乎零开销，PRD10 测试矩阵
# 不会因此误触发 429。
# 开启时（推荐生产环境）：按 `agent_os/common/rate_limit.py::DEFAULT_POLICIES`
# 的 token-bucket 策略给以下路由加限流：
#   - auth_login        POST /api/v1/auth/login           10/分钟/IP
#   - auth_register     POST /api/v1/auth/register         5/分钟/IP
#   - auth_send_code    POST /api/v1/auth/{send-code,...}  5/分钟/IP
#   - ai_messages       POST /api/v1/ai/conversations/.../messages
#                                                         30/分钟/用户
#   - search            ANY  /api/v1/search             120/分钟/用户
#   - capture           POST/PUT /api/v1/capture|/uploads 120/分钟/用户
#   - global            ANY  /api/v1/                   600/分钟/IP
#
# 触发限流时返回 PRD10 envelope 429 + Retry-After 头。
AGENTOS_RATE_LIMIT=off


# ─── §6 Redis ────────────────────────────────────────────────────────────────
# Redis 用途：邮箱验证码 TTL、登录 / AI / 搜索限流、SSE pubsub。
# 不开 Redis 也能跑，但下面这些功能会降级或抛 503：
#   - 邮箱验证码（/auth/send-code 会返回 503）
#   - 任何走 Redis 的限流策略
# 推荐：生产环境 + 演示环境都接 Redis。

REDIS_URL=redis://:redis123@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis123


# ─── §7 文件存储 ─────────────────────────────────────────────────────────────

# 本地文件存储根（开发 / 单机部署用）
PRD10_UPLOADS_BASE=data/uploads

# 大文件分片上传 staging 目录（PRD10 §12.5 / §16.3）
# 拼装完成 / cancel 时会自动清空，所以可以与 PRD10_UPLOADS_BASE 同盘。
PRD10_UPLOADS_MULTIPART_BASE=data/uploads/multipart

# 分片默认大小（字节）。client 可在 init 时显式 override，server 钳到 64 KiB – 64 MiB。
# 5 MiB 与 S3 multipart 最小分片对齐，方便后续切真实对象存储。
AGENTOS_UPLOAD_MULTIPART_CHUNK_SIZE=5242880

# 单个 multipart session TTL（秒）。超时未 complete 时 PUT 会被拒；后台清理脚本可用此值
AGENTOS_UPLOAD_MULTIPART_TTL_SECONDS=86400

# 单文件总大小硬上限（字节）。超出 init 时 400 拒绝。默认 2 GiB。
AGENTOS_UPLOAD_MULTIPART_MAX_BYTES=2147483648

# Presign 后端：`local`（默认，客户端 PUT 回本站 /uploads/local/{id}）或 `s3`（boto3 生成真实预签名 URL）
# AGENTOS_UPLOAD_BACKEND=local
# AGENTOS_UPLOAD_PRESIGN_EXPIRES_SECONDS=900
# AGENTOS_UPLOAD_MAX_SIZE_BYTES=1073741824
#
# S3 / R2 / MinIO（AGENTOS_UPLOAD_BACKEND=s3 时必填 bucket；建议另配 access key）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=mydow-uploads
# AWS_S3_REGION=us-east-1
# AWS_S3_ENDPOINT_URL=
# AGENTOS_UPLOAD_S3_KEY_PREFIX=mydow-uploads/
# AGENTOS_UPLOAD_S3_ACL=private
# AGENTOS_UPLOAD_S3_PUBLIC_READ_BASE=

# ────────────────────────────────────────────────────────────────────────────
# PRD10 §11.7 — 备份与恢复
#
# 一键脚本：scripts/backup/{backup_postgres,restore_postgres,snapshot_uploads}.{sh,ps1}
# docker-compose profile：--profile backup（见 docker-compose.prd10.yml::backup）
# SOP：docs/11-deployment/backup.md（RPO / RTO / 演练步骤 / 故障速查）
#
#   BACKUP_DIR                       本地备份根（默认 .tmp/backups）
#   AGENTOS_BACKUP_RETENTION_DAYS    本地保留天数（默认 14；S3 lifecycle 单独管）
#   AGENTOS_BACKUP_S3_BUCKET         设值则自动 aws s3 cp 异地拷贝
#   AGENTOS_BACKUP_S3_PREFIX         默认 mydow（postgres / uploads 子前缀脚本自管）
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 复用上面 §7 同字段。
BACKUP_DIR=.tmp/backups
AGENTOS_BACKUP_RETENTION_DAYS=14
# AGENTOS_BACKUP_S3_BUCKET=mydow-backups-prod
# AGENTOS_BACKUP_S3_PREFIX=mydow


# ─── §8 第三方集成（可选）────────────────────────────────────────────────────

# 微信公众号 / 服务号（agent_os/integrations/router.py）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_WEBHOOK_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# Sentry 错误监控（PRD10 §11.5）
#
# 默认关闭：未设置 SENTRY_DSN 时整个 Sentry 集成完全 no-op，对 dev/CI/demo
# 零影响。生产部署强烈建议接入：
#
#   1. 去 https://sentry.io 创建 project，拿到 DSN
#   2. 设 SENTRY_DSN
#   3. 设 SENTRY_ENVIRONMENT=production / staging / demo
#   4. 设 SENTRY_RELEASE=<git sha 或语义版本> 让事件能关联到部署
#
# 集成会自动捕获：FastAPI 异常、Starlette 请求、SQLAlchemy 慢查询、
# logging.ERROR+ 日志。before_send hook 会剥离 Authorization / Cookie /
# password / token 等敏感字段后再发送（PII scrubbing）。
SENTRY_DSN=
SENTRY_ENVIRONMENT=production       # 或 staging / demo
# SENTRY_RELEASE=                    # 例：mydow@1.0.0 或 git sha；强烈推荐
SENTRY_TRACES_SAMPLE_RATE=0.1        # 性能 trace 采样率 0.0-1.0；默认 10%
SENTRY_SAMPLE_RATE=1.0               # 错误事件采样率 0.0-1.0；默认 100%
SENTRY_SEND_DEFAULT_PII=false        # 仅当确认隐私合规后再开


# ────────────────────────────────────────────────────────────────────────────
# §11.9 Production seed（一次性 demo 账号 + 默认 Skill）
#
# scripts/production_seed.py 的安全栅栏：默认 OFF，避免误入生产；
# 触发后会幂等调用 seed_prd10.py --reset 但只清自己 [seed] 标签的行。
#
#   1. 设 AGENTOS_PROD_SEED_ON_BOOT=on 启用脚本（默认 OFF = no-op）
#   2. 真实用户检测：DB 内非 demo 用户 > 0 时拒绝执行（除非 FORCE=1）
#   3. DSN 看起来像 production（host 含 prod/production）时拒绝执行
#      （除非 FORCE=1）
#
# 一键运行：
#   docker compose -f docker-compose.prd10.yml --profile seed run --rm seed
AGENTOS_PROD_SEED_ON_BOOT=off              # on/1/true/yes/enabled = 启用
AGENTOS_PROD_SEED_FORCE=                    # 1 = 跳过 production / 真实用户栅栏（危险）
AGENTOS_PROD_SEED_EMAIL=demo@whyme.local
AGENTOS_PROD_SEED_PASSWORD=demo-password-123
AGENTOS_PROD_SEED_FULLNAME=Demo User


# ─── §9 开发与调试 ───────────────────────────────────────────────────────────

# 数字花园强连接阈值（agent_os/core/config.py），0.0~1.0
GARDEN_STRONG_EDGE_THRESHOLD=0.7

# uvicorn auto-reload（仅 development 用）
RELOAD=false

# 性能 profile（写 ./logs/profile-*.json）
PROFILE=false

# Docker / CI 环境标记
ENVIRONMENT=production
